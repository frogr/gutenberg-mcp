# All optional. Copy to .env or set in your host's dashboard. No API keys are needed.

# ---- Upstreams (stdio and HTTP) ----
# Gutendex catalog API base URL (self-host it if the public one is slow).
GUTENDEX_URL=https://gutendex.com
# Timeout for one Gutendex request, ms (stdio default 20000, HTTP default 20000).
GUTENDEX_TIMEOUT_MS=
# Project Gutenberg mirror that book texts are downloaded from (default: Project
# Gutenberg's own mirror). www.gutenberg.org asks automated clients to use mirrors.
# Any mirror from https://www.gutenberg.org/MIRRORS.ALL that serves cache/epub works.
GUTENBERG_MIRROR=https://gutenberg.pglaf.org
# Timeout for downloading one book from the mirror, ms (default 30000).
TEXT_TIMEOUT_MS=
# Largest book file accepted, MB (default 16).
MAX_BOOK_MB=16
# Memory budget for parsed books, MB, estimated (default 160).
BOOK_CACHE_MB=160

# ---- HTTP server only (npm start / dist/http.js) ----
PORT=3000
HOST=0.0.0.0
# Requests per minute per IP on POST /mcp.
RATE_LIMIT_PER_MINUTE=30
# Requests per UTC day on POST /mcp across all callers (keeps a public demo polite to upstreams).
DAILY_REQUEST_LIMIT=5000
# Largest accepted POST body in bytes.
MAX_BODY_BYTES=65536
# Wall-clock limit for one /mcp request, ms.
REQUEST_TIMEOUT_MS=30000
# "*" or a comma-separated list of allowed browser origins.
CORS_ORIGINS=*
# Number of reverse proxies in front of the app (Render: 1). 0 = use the socket address.
TRUST_PROXY=0
